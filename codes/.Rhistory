dane <- read.csv("zadanie-8.csv")
with(dane, sum(waga*wiek))
Xs <- model.matrix(~ 0 + plec + wiek, dane)
g <- calib(Xs = Xs,
d = dane$waga,
total = c(60000, 58000, 5000000),
method = "linear")
dane$waga_finalna <- dane$waga*g
median(dane$waga_finalna)
