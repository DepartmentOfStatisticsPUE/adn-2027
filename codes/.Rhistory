N <- 100000
n_audit <- 1000
n_sim = 100
set.seed(2025)
error_precise=error_naive=error_bca_naive=error_bca=matrix(0, n_sim, 3)
colnames(error_precise)=colnames(error_naive)=colnames(error_bca_naive)=colnames(error_bca)=c('z', 'Intercept', 'x')
x <- rnorm(N, 2, 1)
z <- rbinom(N, 1, 0.7)
z_star <- z
z_star[z == 1] <- sample(c(0,1), size = NROW(z_star[z == 1]), prob = c(0.10, 0.90), replace = T)
z_star[z == 0] <- sample(c(0,1), size = NROW(z_star[z == 0]), prob = c(0.93, 0.07), replace = T)
e <- rnorm(N)
y <- 1 + x - 2*z + e
pop_data <- data.frame(x, z, z_star, y)
x
s_audit = pop_data[sample(1:nrow(pop_data), n_audit),]
s_audit
head(s_audit)
fpr=sum(s_audit$z==0 & s_audit$z_star==1)/nrow(s_audit)
errors=s_audit$z_star - s_audit$z
lambda=c(mean(errors), mean(s_audit$x*errors))
ksi=rbind(z, rep(1, N), x)
ksi
dim(ksi)
psi_hat_precise=solve(1/N*ksi%*%t(ksi))%*%(1/N*ksi%*%y)
psi_hat_precise
psi_hat_precise=MASS::ginv(1/N*ksi%*%t(ksi))%*%(1/N*ksi%*%y)
psi_hat_precise
lambda
exptilt_engine
library(readxl)
library(glmnet)
gosp <- read_excel("../data/gospodarstwa-zajecia.xlsx")
gosp <- transform(gosp,
klm = as.factor(klm),
woj = as.factor(woj))
head(gosp)
summary(gosp[, c("dochg", "wydg")])
gosp$R <- !is.na(gosp$dochg)
m1 <- glm(R ~ klm + woj, data = gosp, family = binomial())
summary(predict(m1, type = "response"))
gosp$w_rho <- 1/predict(m1, gosp, type="response")
c(mean(gosp$dochg, na.rm=T), weighted.mean(gosp$dochg, gosp$w_rho, na.rm=T))
m2 <- cv.glmnet(x = model.matrix(~ klm + woj, gosp), y = gosp$R, family = "binomial")
m2
coef(m2)
gosp$w_rho_lasso <- 1/as.numeric(predict(m2, newx = model.matrix(~ klm + woj, gosp), type="response", s = m2$lambda.min))
c(bez = mean(gosp$dochg, na.rm=T),
glm = weighted.mean(gosp$dochg, gosp$w_rho, na.rm=T),
lasso = weighted.mean(gosp$dochg, gosp$w_rho_lasso, na.rm=T))
summary(gosp[, c("w_rho", "w_rho_lasso")])
plot(gosp$w_rho, gosp$w_rho_lasso)
